# UnityTrack Environment Configuration Example

# Backend Configuration
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Database Configuration (PostgreSQL with psycopg3)
# In Docker: postgresql+psycopg://unitytrack:unitytrack@db:5432/unitytrack
# Local SQLite fallback if unset or local postgres:
DATABASE_URL=postgresql+psycopg://unitytrack:unitytrack@localhost:5432/unitytrack

# Security & CORS (Comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optimizer Configuration (Deterministic CP-SAT solver parameters)
SOLVER_TIME_LIMIT_SECONDS=30
SOLVER_WORKERS=4
SOLVER_RANDOM_SEED=42

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
